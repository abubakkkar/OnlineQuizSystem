@page
@model OnlineQuizSystem.Pages.Teacher.ManageSectionsModel
@{
    ViewData["Title"] = "Manage Sections";
}

<div class="glass-card" style="max-width: 1000px;">
    <h2 class="card-title">Manage Course Sections</h2>
    <p class="card-subtitle">Create and manage sections for your course</p>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div style="padding: 1rem; border-left: 4px solid #10b981; background: rgba(16, 185, 129, 0.1); border-radius: 4px; margin-bottom: 1.5rem; color: #047857;">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="padding: 1rem; border-left: 4px solid #ef4444; background: rgba(239, 68, 68, 0.1); border-radius: 4px; margin-bottom: 1.5rem; color: #991b1b;">
            @Model.ErrorMessage
        </div>
    }

    <!-- Create New Section -->
    <div style="background: var(--bg-secondary); padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
        <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">➕ Create New Section</h3>
        
        <form method="post" asp-page-handler="Create" style="display: grid; grid-template-columns: 1fr 1fr auto auto; gap: 1rem; align-items: end;">
            <div>
                <label class="form-label">Section Name</label>
                <input type="text" name="SectionName" class="form-control" placeholder="e.g., Class A" required />
            </div>

            <div>
                <label class="form-label">Description</label>
                <input type="text" name="Description" class="form-control" placeholder="Brief description" />
            </div>

            <div>
                <label class="form-label">Quiz Time (minutes)</label>
                <input type="number" name="MaxTimeMinutes" class="form-control" placeholder="5" min="1" max="180" value="5" required />
            </div>

            <button type="submit" class="btn-primary" style="padding: 0.8rem 1.5rem; height: fit-content;">
                Create Section
            </button>
        </form>
    </div>

    <!-- Existing Sections -->
    <div>
        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">📚 Your Sections</h3>
        
        @if (Model.TeacherSections != null && Model.TeacherSections.Rows.Count > 0)
        {
            <div style="display: grid; gap: 0.75rem;">
                @foreach (System.Data.DataRow section in Model.TeacherSections.Rows)
                {
                    <div style="padding: 1.25rem; border: 1px solid var(--border); border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-weight: 600; font-size: 1rem;">@(section["SectionName"])</div>
                            @if (section["Description"] != DBNull.Value && !string.IsNullOrEmpty(section["Description"].ToString()))
                            {
                                <div style="font-size: 0.9rem; color: var(--text-muted); margin-top: 0.25rem;">@(section["Description"])</div>
                            }
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;">Created: @Convert.ToDateTime(section["CreatedDate"]).ToString("MMM dd, yyyy") · ⏱ @(section.Table.Columns.Contains("MaxTimeMinutes") && section["MaxTimeMinutes"] != DBNull.Value ? section["MaxTimeMinutes"].ToString() : "30") min</div>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            <form method="post" asp-page-handler="Delete" asp-route-sectionId="@(section["SectionID"])" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this section?');">
                                <button type="submit" class="btn-danger" style="padding: 0.5rem 1rem; background: #ef4444; color: white; border: none; border-radius: 4px; cursor: pointer;">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="padding: 2rem; text-align: center; background: var(--bg-secondary); border-radius: 8px;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">📭</div>
                <p style="color: var(--text-muted);">You haven't created any sections yet. Create one to get started!</p>
            </div>
        }
    </div>

    <div style="margin-top: 2rem;">
        <a asp-page="/Teacher/Index" class="btn-secondary" style="display: inline-block; padding: 0.8rem 1.5rem;">
            ← Back to Panel
        </a>
    </div>
</div>
