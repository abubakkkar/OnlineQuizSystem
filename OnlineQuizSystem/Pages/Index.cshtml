@page
@{
    ViewData["Title"] = "Home";
}

<div class="glass-card hero-card page-hero">
    <h1 class="hero-title">BrainSpark Quiz</h1>
    <p class="hero-subtitle">
        Test your knowledge, challenge yourself, and learn new things with our interactive online quiz system. Are you ready to spark your brain?
    </p>
    <div class="hero-actions">
        <a asp-page="/Auth/Signup" class="btn-primary hero-action">Get Started Now</a>
        <a asp-page="/Auth/Login" class="btn-secondary hero-action">Login</a>
        <a asp-page="/Auth/AdminLogin" class="btn-secondary hero-action">Admin Portal</a>
    </div>
</div>
