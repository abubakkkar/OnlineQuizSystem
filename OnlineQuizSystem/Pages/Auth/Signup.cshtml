@page
@model OnlineQuizSystem.Pages.Auth.SignupModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="glass-card">
    <h2 class="card-title">Create Account</h2>
    <p class="card-subtitle">Join BrainSpark and start quizzing</p>

    <div asp-validation-summary="ModelOnly" class="alert"></div>

    <form method="post">
        <div class="form-group">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" placeholder="Muhammad Ali" />
            <span asp-validation-for="Input.Name" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.RollNo" class="form-label"></label>
            <input asp-for="Input.RollNo" class="form-control" placeholder="2025-XX-000" />
            <span asp-validation-for="Input.RollNo" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" placeholder="rollno@student.uet.edu.pk" />
            <span asp-validation-for="Input.Email" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>
        
        <div class="form-group">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="Input.Password" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="color: var(--danger); font-size: 0.85rem;"></span>
        </div>
        
        <button type="submit" class="btn-primary" style="width: 100%; padding: 0.95rem 1.1rem; font-size: 1rem; margin-top: 0.5rem; border-radius: 16px;">
            Create Account
        </button>
    </form>

    <div class="text-center mt-4" style="color: var(--text-muted); font-size: 0.9rem;">
        Already have an account? <a asp-page="./Login" style="color: var(--primary); text-decoration: none; font-weight: 600;">Sign in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
