@page
@model OnlineQuizSystem.Pages.Quiz.TakeModel
@{
    ViewData["Title"] = "Take Quiz";
}

<style>
    .quiz-container {
        display: flex;
        gap: 2rem;
        position: relative;
    }

    .quiz-container.selection-mode {
        display: block;
        max-width: 900px;
        text-align: center;
        padding: 3.5rem 3rem;
    }

    .quiz-main {
        flex: 1;
        min-width: 0;
    }

    .quiz-sidebar {
        width: 280px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 1.5rem;
        height: fit-content;
        position: sticky;
        top: 2rem;
    }

    .quiz-sidebar-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--primary);
    }

    .progress-stat {
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .progress-stat:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .stat-label {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
    }

    .progress-bar {
        width: 100%;
        height: 8px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
        overflow: hidden;
        margin-top: 0.5rem;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--primary), var(--success));
        transition: width 0.3s ease;
    }

    .submit-button-container {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .submit-button {
        width: 100%;
        padding: 0.8rem;
        background: var(--success);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .submit-button:hover {
        background: #10b981;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(52, 211, 153, 0.3);
    }

    .submit-button:disabled {
        background: var(--text-muted);
        cursor: not-allowed;
        transform: none;
    }

    /* Teacher Selection Styling */
    .selection-header {
        margin-bottom: 2.5rem;
    }

    .text-gradient {
        background: linear-gradient(120deg, var(--primary), var(--secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2.25rem;
        font-weight: 800;
    }

    .teacher-selection-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.8rem;
        margin: 2rem 0;
        justify-content: center;
    }

    .teacher-card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.07));
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 2.2rem 1.8rem;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
        overflow: hidden;
        width: 100%;
        color: var(--text-main);
    }

    .teacher-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), rgba(244, 114, 182, 0.08));
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 0;
    }

    .teacher-card:hover {
        transform: translateY(-8px);
        border-color: rgba(34, 211, 238, 0.35);
        box-shadow: 0 20px 45px rgba(34, 211, 238, 0.15), 
                    inset 0 0 15px rgba(34, 211, 238, 0.05);
    }

    .teacher-card:hover::before {
        opacity: 1;
    }

    .teacher-avatar-container {
        width: 84px;
        height: 84px;
        background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(244, 114, 182, 0.1));
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        font-size: 2.6rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        transition: all 0.4s ease;
        position: relative;
        z-index: 1;
    }

    .teacher-card:hover .teacher-avatar-container {
        transform: scale(1.1) rotate(6deg);
        border-color: var(--primary);
        box-shadow: 0 10px 30px rgba(34, 211, 238, 0.25);
    }

    .teacher-name {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.4rem;
        color: var(--text-main);
        letter-spacing: -0.01em;
        position: relative;
        z-index: 1;
    }

    .teacher-role {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1.8rem;
        position: relative;
        z-index: 1;
    }

    .attempt-btn {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-main);
        padding: 0.75rem 1.4rem;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .teacher-card:hover .attempt-btn {
        background: linear-gradient(135deg, var(--primary), var(--primary-hover));
        color: white;
        border-color: transparent;
        box-shadow: 0 10px 25px rgba(6, 182, 212, 0.3);
        transform: translateY(-2px);
    }

    .teacher-card:active .attempt-btn {
        transform: translateY(0);
    }

    .teacher-card:hover .attempt-btn svg {
        transform: translateX(4px);
    }

    @@media (max-width: 1024px) {
        .quiz-container {
            flex-direction: column;
        }

        .quiz-container.selection-mode {
            padding: 2.5rem 1.5rem;
        }

        .quiz-sidebar {
            width: 100%;
            position: static;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
        }

        .progress-stat {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
            text-align: center;
        }

        .submit-button-container {
            grid-column: 1 / -1;
            margin-top: 0;
            padding-top: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }
    }
</style>

<div class="glass-card quiz-container @(!Model.TeacherSelected ? "selection-mode" : "")">
    @if (!Model.TeacherSelected)
    {
        <div class="text-center">
            <div class="selection-header">
                <h2 class="card-title text-gradient" style="margin-bottom: 0.75rem;">Select Your Instructor</h2>
                <p class="card-subtitle">Choose which teacher's quiz session you want to attempt today</p>
            </div>
            
            @if (Model.EnrolledTeachers != null && Model.EnrolledTeachers.Rows.Count > 0)
            {
                <form method="get">
                    <div class="teacher-selection-grid">
                        @foreach (System.Data.DataRow teacher in Model.EnrolledTeachers.Rows)
                        {
                            <button type="submit" name="teacherId" value="@teacher["TeacherID"]" class="teacher-card">
                                <div class="teacher-avatar-container">
                                    👨‍🏫
                                </div>
                                <h3 class="teacher-name">@teacher["Name"]</h3>
                                <p class="teacher-role">Faculty Instructor</p>
                                <div class="attempt-btn">
                                    <span>Attempt Quiz</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="transition: transform 0.3s;">
                                        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                                    </svg>
                                </div>
                            </button>
                        }
                    </div>
                </form>
            }
            else
            {
                <div style="margin-bottom: 2rem; padding: 2rem 0;">
                    <div style="font-size: 3.5rem; margin-bottom: 1rem; filter: drop-shadow(0 8px 16px rgba(34,211,238,0.2));">📚</div>
                    <h3 style="margin-bottom: 0.75rem; font-size: 1.5rem;">No Teachers Enrolled</h3>
                    <p style="color: var(--text-muted); margin-bottom: 2.2rem; max-width: 480px; margin-left: auto; margin-right: auto;">You need to be enrolled in at least one teacher's section to take a quiz.</p>
                    <a asp-page="/Dashboard/Index" class="btn-primary" style="display: inline-block;">Back to Dashboard</a>
                </div>
            }
        </div>
    }
    else if (Model.HasAlreadyAttempted)
    {
        <div class="text-center" style="padding: 3rem 2rem;">
            <div style="font-size: 4rem; margin-bottom: 1.5rem; filter: drop-shadow(0 8px 16px rgba(34,211,238,0.2));">✅</div>
            <h2 class="card-title text-gradient" style="margin-bottom: 1rem;">Quiz Already Completed</h2>
            <p style="color: var(--text-muted); margin-bottom: 2.5rem; max-width: 480px; margin-left: auto; margin-right: auto;">
                You have already attempted and submitted the quiz for this teacher. Each student is allowed only one attempt per teacher.
            </p>
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a asp-page="/Results/Index" class="btn-primary" style="display: inline-block; padding: 0.8rem 2rem;">View My Results</a>
                <a asp-page="/Dashboard/Index" class="btn-secondary" style="display: inline-block; padding: 0.8rem 2rem; border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; text-decoration: none;">Back to Dashboard</a>
            </div>
        </div>
    }
    else if (Model.Question != null)
    {
        <div class="quiz-main">
            <div class="quiz-header">
                <div>
                    <span style="color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">Difficulty Level</span>
                    <div style="font-weight: 700; color: var(--primary);">Level @Model.Difficulty</div>
                </div>
                <div class="timer" id="timerDisplay">--:--</div>
            </div>

            <h3 class="question-text">@Model.Question["QuestionText"]</h3>

            <form method="post" id="quizForm">
                <input type="hidden" name="QuestionID" value="@Model.Question["QuestionID"]" />
                <input type="hidden" name="CorrectAnswer" value="@Model.Question["CorrectOption"]" />
                
                <div class="options-grid">
                    <label class="option-label" onclick="selectOption(this)">
                        <input type="radio" asp-for="SelectedAnswer" value="A" required />
                        <span style="font-size: 2.5rem;">A</span>
                        <span style="font-size: 0.9rem; color: var(--text-muted);">@Model.Question["OptionA"]</span>
                    </label>
                    
                    <label class="option-label" onclick="selectOption(this)">
                        <input type="radio" asp-for="SelectedAnswer" value="B" required />
                        <span style="font-size: 2.5rem;">B</span>
                        <span style="font-size: 0.9rem; color: var(--text-muted);">@Model.Question["OptionB"]</span>
                    </label>
                    
                    <label class="option-label" onclick="selectOption(this)">
                        <input type="radio" asp-for="SelectedAnswer" value="C" required />
                        <span style="font-size: 2.5rem;">C</span>
                        <span style="font-size: 0.9rem; color: var(--text-muted);">@Model.Question["OptionC"]</span>
                    </label>
                    
                    <label class="option-label" onclick="selectOption(this)">
                        <input type="radio" asp-for="SelectedAnswer" value="D" required />
                        <span style="font-size: 2.5rem;">D</span>
                        <span style="font-size: 0.9rem; color: var(--text-muted);">@Model.Question["OptionD"]</span>
                    </label>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn-primary" style="padding: 0.8rem 3rem; font-size: 1.1rem;">Submit Answer</button>
                </div>
            </form>
        </div>

        <div class="quiz-sidebar">
            <div class="quiz-sidebar-title">📊 Quiz Progress</div>
            
            <div class="progress-stat">
                <div class="stat-label">Total Questions</div>
                <div class="stat-value">@Model.TotalQuestions</div>
            </div>

            <div class="progress-stat">
                <div class="stat-label">Attempted</div>
                <div class="stat-value">@Model.AttemptedQuestions</div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @((Model.TotalQuestions > 0 ? (Model.AttemptedQuestions * 100 / Model.TotalQuestions) : 0))%"></div>
                </div>
            </div>

            <div class="progress-stat">
                <div class="stat-label">Remaining</div>
                <div class="stat-value">@(Model.TotalQuestions - Model.AttemptedQuestions)</div>
            </div>

            <div class="progress-stat">
                <div class="stat-label">Time Left</div>
                <div class="stat-value" id="sidebarTimer">--:--</div>
            </div>

            <div class="submit-button-container">
                <form method="post" asp-page-handler="Submit" style="display: inline;">
                    <button type="submit" class="submit-button" onclick="return confirm('Are you sure you want to submit the quiz? You cannot change your answers after submission.');">
                        ✓ Submit Quiz
                    </button>
                </form>
            </div>
        </div>

        <script>
            function selectOption(element) {
                document.querySelectorAll('.option-label').forEach(el => el.classList.remove('selected'));
                element.classList.add('selected');
                element.querySelector('input').checked = true;
            }

            // Quiz Timer
            let timeLeft = @Model.TimeLeftSeconds;
            const timerEl = document.getElementById('timerDisplay');
            const sidebarTimerEl = document.getElementById('sidebarTimer');
            const form = document.getElementById('quizForm');
            
            function formatTime(seconds) {
                const m = Math.floor(seconds / 60);
                const s = seconds % 60;
                return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
            }

            timerEl.innerText = formatTime(timeLeft);
            sidebarTimerEl.innerText = formatTime(timeLeft);
            
            const timer = setInterval(() => {
                timeLeft--;
                timerEl.innerText = formatTime(timeLeft);
                sidebarTimerEl.innerText = formatTime(timeLeft);
                
                if(timeLeft <= 60) {
                    timerEl.style.color = 'var(--danger)';
                    timerEl.style.borderColor = 'rgba(239, 68, 68, 0.2)';
                    timerEl.style.background = 'rgba(239, 68, 68, 0.1)';
                }
                
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    window.removeEventListener('beforeunload', preventLeave);
                    // Auto-submit when time is up
                    document.querySelectorAll('form')[0].submit();
                }
            }, 1000);

            // Prevent leaving page during quiz
            function preventLeave(e) {
                e.preventDefault();
                e.returnValue = '';
            }
            window.addEventListener('beforeunload', preventLeave);

            // Disable back/forward navigation cache behavior
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    window.location.reload();
                }
            });

            // Handle form submission
            form.addEventListener('submit', function() {
                window.removeEventListener('beforeunload', preventLeave);
            });
        </script>
    }
    else
    {
        <div class="text-center">
            <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
            <h3 style="margin-bottom: 1rem;">No Questions Available</h3>
            <p style="color: var(--text-muted); margin-bottom: 2rem;">It seems the database is empty or not connected. If you are an administrator, please add some questions or check the database connection.</p>
            <a asp-page="/Dashboard/Index" class="btn-secondary">Return to Dashboard</a>
        </div>
    }
</div>
